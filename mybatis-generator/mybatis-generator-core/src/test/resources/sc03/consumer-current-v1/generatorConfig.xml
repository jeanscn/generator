                    <htmlButton id="row-sensitive-word-versioned-delete" text="true" title="版本化删除词条"
                                label="删除" handler="defaultViewRowAction" configurable="true"/>
                    <htmlButton id="row-sensitive-word-versioned-restore" text="true" title="版本化恢复词条"
                                label="恢复" handler="defaultViewRowAction" showCondition="deleteFlag == 1"
                                configurable="true"/>
                    <htmlButton id="top-sensitive-word-deleted-list" title="打开已删除词条列表"
                                label="已删除" handler="defaultDtCustomButtonAction" configurable="true"/>

                                    includeElements="code_,name_,notes_,sort_,state_"/>
                </layout>
            </generateHtml>
            <!-- 已有人工 DDL 含必建索引、CHECK 和固定 revision 行，禁止生成 schema 覆盖它。 -->
            <generateSqlSchema generate="false"/>
            <generateVo generate="true">
                <modelVo generate="true" excludeColumns="code_hash_"/>
                <!-- 创建/更新白名单不接受客户端摘要；更新须保留父类 id/version 的并发契约。 -->
                <createVo generate="true" includeColumns="code_,name_,notes_,sort_,state_"
                          requiredColumns="code_,name_" genIsSelective="false"/>
                <updateVo generate="true" includeColumns="id_,version_,code_,name_,notes_,sort_,state_"
                          requiredColumns="id_,version_" genIsSelective="false"/>
                <viewVo generate="true" excludeColumns="code_hash_" title="敏感词分类"
                        toolbar="CREATE,top-sensitive-category-deleted-list"
                        indexColumn="NONE"
                        actionColumn="ROW_EDIT,row-sensitive-category-versioned-delete,row-sensitive-category-versioned-restore,ROW_VIEW"
                        queryColumns="code_,name_,state_"
                        defaultDisplayFields="code,name,state,sort,created" enablePager="true"
                        defaultSort="sort_ asc,id_ asc">
                    <columnRenderFun fieldNames="state" renderFun="colDefsState"/>
                    <htmlButton id="row-sensitive-category-versioned-delete" text="true" title="版本化删除分类"
                                label="删除" handler="defaultViewRowAction" configurable="true"/>
                    <htmlButton id="row-sensitive-category-versioned-restore" text="true" title="版本化恢复分类"
                                label="恢复" handler="defaultViewRowAction" showCondition="deleteFlag == 1"
                                configurable="true"/>
                    <htmlButton id="top-sensitive-category-deleted-list" title="打开已删除分类列表"
                                label="已删除" handler="defaultDtCustomButtonAction" configurable="true"/>
                    <queryColumn column="code_" remark="分类编码" queryMode="EqualTo"/>
                    <queryColumn column="name_" remark="分类名称" queryMode="EqualTo"/>
                    <queryColumn column="state_" remark="状态" queryMode="EqualTo"/>
                </viewVo>
                <excelVo generate="false"/>
                <requestVo generate="true" includePageParam="true" excludeColumns="code_hash_"/>
            </generateVo>
            <generateCachePo generate="true" valueColumn="name_"/>
            <columnOverride column="code_" maxLength="64"/>
            <columnOverride column="name_" maxLength="128"/>
            <columnOverride column="notes_" maxLength="1000"/>
        </table>

        <!--

            category_id 为可空分类，不增加父子树或级联写入。
            strategy_ 为 NULL 时继承全局，否则仅允许 BLOCK/CONFIRM/REPLACE/WARN。
            词库自身不标记敏感检测字段，避免管理词条时递归检测。
        -->
        <table ignore="false" tableName="sensitive_word" domainObjectName="SensitiveWord" alias="sw"
               isModules="true" enableDropTables="false" cleanAllGeneratedElements="false"
               enableSelectForUpdate="true">
            <property name="rootClass" value="com.vgosoft.core.entity.abs.AbstractPersistenceLockEntity"/>

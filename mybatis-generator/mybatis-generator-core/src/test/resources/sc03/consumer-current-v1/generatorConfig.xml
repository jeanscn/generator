                <property name="isLogicalDelete" value="true"/>
            </selectByColumn>
            <generateModel generate="true" noMetaAnnotation="false" enableChildren="false"/>
            <generateSqlMap generate="true"/>
            <generateDao generate="true"/>
            <generateService generate="true" noServiceAnnotation="false" generateUnitTest="false">
                <disabledMethod signature="insert(com.vgosoft.sensitive.entity.SensitiveWord)"

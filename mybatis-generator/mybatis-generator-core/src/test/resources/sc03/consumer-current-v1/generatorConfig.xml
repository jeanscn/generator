                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByExampleSelectiveAndSelect(com.vgosoft.sensitive.entity.SensitiveWord,com.vgosoft.sensitive.entity.example.SensitiveWordExample)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByExample(com.vgosoft.sensitive.entity.SensitiveWord,com.vgosoft.sensitive.entity.example.SensitiveWordExample)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByPrimaryKey(com.vgosoft.sensitive.entity.SensitiveWord)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="insertBySql(com.vgosoft.mybatis.sqlbuilder.InsertSqlBuilder)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="updateBySql(com.vgosoft.mybatis.sqlbuilder.UpdateSqlBuilder)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="insertBatch(java.util.List)"
                                reason="词条写入必须经过规则版本管理" internalMethod="insertBatchInternal"/>
                <disabledMethod signature="updateDeleteFlag(com.vgosoft.sensitive.entity.SensitiveWord,int)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="insertOrUpdate(com.vgosoft.sensitive.entity.SensitiveWord)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByPrimaryKeyCas(com.vgosoft.sensitive.entity.SensitiveWord,java.lang.Integer)"
                                reason="词条写入必须经过规则版本管理" internalMethod="updateByPrimaryKeyCasInternal"/>
                <disabledMethod signature="updateByPrimaryKeySelectiveCas(com.vgosoft.sensitive.entity.SensitiveWord,java.lang.Integer)"
                                reason="词条写入必须经过规则版本管理"/>
                <disabledMethod signature="deleteByPrimaryKey(java.lang.String)"
                                reason="无版本单条删除已停用，请使用带版本删除接口"/>
                <disabledMethod signature="deleteByExample(com.vgosoft.sensitive.entity.example.SensitiveWordExample)"
                                reason="无逐条版本的批量删除已停用，请使用带版本批量删除接口"/>
            </generateService>
            <generateController generate="true" noSwaggerAnnotation="false" generateUnitTest="false">
                <property name="enableSysLogAnnotation" value="true"/>
            </generateController>
            <generateHtml generate="true" type="editable" viewPath="sensitive_word"
                          overWriteHtmlFile="false" overWriteJsFile="false">
                <layout popSize="default" size="default">
                    <groupContainer elementKey="main-form-info" type="border" columnNum="1"
                                    includeElements="word_,category_id,strategy_,state_,notes_"/>
                </layout>
                <!-- 对齐当前生成 Controller 的分类选项路由；运行权限与响应仍须在 W11 联调验收。 -->

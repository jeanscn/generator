        不自动更新数据库中的模块/菜单数据；人工扩展前须移除对应强制覆盖类型。
        正式配置保持 onlyTables 为空；每次运行须按批准范围临时限定并在结束后恢复，不把空值当成完整白名单。
    -->
    <context id="SensitiveTables"
             appKeyword="sensitive"
             moduleKeyword="sensitive"
             moduleName="敏感词管理"
             parentMenuId="1777340268517920770"
             jdkVersion="17"
             integrateMybatisPlus="false"
             integrateSpringSecurity="true"
             forceUpdateScalableElement="true"
             vueEndProjectPath="target/sc03-consumer-current-v1/web"
             onlyTables=""
             updateModuleData="true"
             updateMenuData="true">
        <property name="forceUpdateElementList" value="vo,modelVo,createVo,excelVo,requestVo,updateVo,viewVo,maps"/>
        <property name="rootModuleName" value="vgosoft-root"/>
        <property name="springBootApplicationClass" value="com.vgosoft.vgosoftroot.VgosoftRootApplication"/>
        <!-- 当前连接为 MySQL；仅声明已落地的 mysql，不推定 DM/PostgreSQL 已完成验收。 -->
        <property name="additionalDbTypes" value="mysql"/>
        <!-- UI 隐藏不是写入授权；摘要、操作者及租户仍须由受控服务计算或绑定。 -->
        <property name="htmlHiddenFields"
                  value="id,deleteFlag,version,created,modified,createdId,modifiedId,tenantId,owner,codeHash,wordHash,categoryCascadeDisabled"/>

        <!--
            driverClass、connectionURL、userId 与 vgosoft-root 的 application-local-mysql.yml 一致。
            XML 中 &amp; 解码后为 JDBC URL 的 &；数据库为 nddc_v2，不是其他模块旧配置的 tmri_v2。
            外部属性未提供时不得执行生成；生成器不会自动读取 Spring YAML 或环境变量。
            useInformationSchema 用于内省表/字段中文注释。
        -->
        <connectionFactory type="org.mybatis.generator.codegen.mybatis3.CasConsumerBaselineTest$MetadataFactory"/>
        <javaTypeResolver/>
        <!-- 从 vgosoft-sensitive 模块目录执行，避免把相对输出路径落到根工程。 -->
        <javaModelGenerator targetPackage="com.vgosoft.sensitive.entity" targetProject="target/sc03-consumer-current-v1"/>
        <sqlMapGenerator targetPackage="mappers" targetProject="target/sc03-consumer-current-v1"/>
        <javaClientGenerator targetPackage="com.vgosoft.sensitive.dao" targetProject="target/sc03-consumer-current-v1" type="XMLMAPPER"/>

        <!--
            分类：非树形，继承排序/乐观锁父类；state_ 由实体显式生成。
            所有管理写入都须在扩展服务中完成摘要、唯一性、版本 CAS、分类引用校验和 revision 同事务递增。
            在这些扩展完成前，不得把生成的通用 CRUD 直接部署为可用管理接口。
        -->
        <table ignore="false" tableName="sensitive_category" domainObjectName="SensitiveCategory" alias="sc"
               isModules="true" enableDropTables="false" cleanAllGeneratedElements="false"
               enableSelectForUpdate="true">
            <property name="rootClass" value="com.vgosoft.core.entity.abs.AbstractPersistenceLockSortableEntity"/>
            <!-- 通用版本化逻辑删除；墓碑、revision 与引用保护仍须由扩展服务统一接管。 -->
            <selectByColumn column="id_,version_" enableDelete="true"
                            parameterType="single" genControllerMethod="true">
                <property name="isLogicalDelete" value="true"/>
            </selectByColumn>
            <generateModel generate="true" noMetaAnnotation="false" enableChildren="false"/>
            <generateSqlMap generate="true"/>
            <generateDao generate="true"/>
            <generateService generate="true" noServiceAnnotation="false" generateUnitTest="false">
                <disabledMethod signature="insert(com.vgosoft.sensitive.entity.SensitiveCategory)"
                                reason="分类写入必须经过规则版本管理" internalMethod="insertInternal"/>
                <disabledMethod signature="insertSelective(com.vgosoft.sensitive.entity.SensitiveCategory)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="insertOrUpdateSelective(com.vgosoft.sensitive.entity.SensitiveCategory)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByExampleSelective(com.vgosoft.sensitive.entity.SensitiveCategory,com.vgosoft.sensitive.entity.example.SensitiveCategoryExample)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByExampleSelectiveAndSelect(com.vgosoft.sensitive.entity.SensitiveCategory,com.vgosoft.sensitive.entity.example.SensitiveCategoryExample)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByExample(com.vgosoft.sensitive.entity.SensitiveCategory,com.vgosoft.sensitive.entity.example.SensitiveCategoryExample)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByPrimaryKey(com.vgosoft.sensitive.entity.SensitiveCategory)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="insertBySql(com.vgosoft.mybatis.sqlbuilder.InsertSqlBuilder)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="updateBySql(com.vgosoft.mybatis.sqlbuilder.UpdateSqlBuilder)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="insertBatch(java.util.List)"
                                reason="分类写入必须经过规则版本管理" internalMethod="insertBatchInternal"/>
                <disabledMethod signature="updateDeleteFlag(com.vgosoft.sensitive.entity.SensitiveCategory,int)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="insertOrUpdate(com.vgosoft.sensitive.entity.SensitiveCategory)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="updateByPrimaryKeyCas(com.vgosoft.sensitive.entity.SensitiveCategory,java.lang.Integer)"
                                reason="分类写入必须经过规则版本管理" internalMethod="updateByPrimaryKeyCasInternal"/>
                <disabledMethod signature="updateByPrimaryKeySelectiveCas(com.vgosoft.sensitive.entity.SensitiveCategory,java.lang.Integer)"
                                reason="分类写入必须经过规则版本管理"/>
                <disabledMethod signature="deleteByPrimaryKey(java.lang.String)"
                                reason="无版本单条删除已停用，请使用带版本删除接口"/>
                <disabledMethod signature="deleteByExample(com.vgosoft.sensitive.entity.example.SensitiveCategoryExample)"
                                reason="无逐条版本的批量删除已停用，请使用带版本批量删除接口"/>
            </generateService>
            <generateController generate="true" noSwaggerAnnotation="false" generateUnitTest="false">
                <property name="enableSysLogAnnotation" value="true"/>
                <generateOptions nameColumn="name_"/>
            </generateController>
            <!-- 父菜单来源和权限部署待宿主核验；仅为本切片生成两表管理页面。 -->
            <generateHtml generate="true" type="editable" viewPath="sensitive_category"
